<%# Lista de ranking — itera Entry uniformes (Quiz::Leaderboard).
    Cada linha: posição/medalha, nickname + email mascarado, total de pontos e nº de partidas. %>
<div class="rank-list">
  <% entries.each do |entry| %>
    <%
      is_me  = user_signed_in? && entry.user_id == current_user.id
      medal  = case entry.rank
               when 1 then "🥇"
               when 2 then "🥈"
               when 3 then "🥉"
               else "#{entry.rank}."
               end
    %>
    <div class="rank-row<%= ' is-me' if is_me %>">
      <span class="rank-medal"><%= medal %></span>
      <div class="rank-info">
        <p class="rank-name"><%= entry.nickname %><%= " (você)" if is_me %></p>
        <p class="rank-detail"><%= entry.masked_email %> · <%= entry.detail %></p>
      </div>
      <span class="rank-score"><%= entry.value %></span>
    </div>
  <% end %>
</div>
