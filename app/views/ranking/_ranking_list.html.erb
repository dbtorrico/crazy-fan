<%# Lista de ranking — linha: posição · avatar · nome+sub-label · pontos %>
<div class="rank-list">
  <% entries.each do |entry| %>
    <% is_me = user_signed_in? && entry.user_id == current_user.id %>
    <div class="row<%= ' me' if is_me %>">
      <span class="row-pos"><%= entry.rank %></span>
      <span class="avatar" style="background:<%= avatar_color(entry.nickname) %>;">
        <%= avatar_monogram(entry.nickname) %>
      </span>
      <div class="row-info">
        <p class="row-name"><%= entry.nickname %><%= " · você" if is_me %></p>
        <small class="row-sub"><%= entry.masked_email %> · <%= entry.detail %></small>
        <% if entry.badges.present? %>
          <p class="rank-badges">
            <% entry.badges.first(5).each do |b| %>
              <span title="<%= b.label %>"><%= b.emoji %></span>
            <% end %>
          </p>
        <% end %>
      </div>
      <span class="row-pts"><%= entry.value %></span>
    </div>
  <% end %>
</div>
