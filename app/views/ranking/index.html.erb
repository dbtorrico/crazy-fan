<% content_for :title, "Ranking — Torcedor Maluco" %>

<div class="tm-app">
  <%= render "matches/header" %>

  <div class="rank-wrap">
    <h2 class="rank-title">🏆 Ranking</h2>

    <%# Toggle de período — só aparece quando há mais de um período habilitado. %>
    <% if @periods.size > 1 %>
      <div class="rank-tabs">
        <% @periods.each do |p| %>
          <%= link_to p.label, ranking_path(period: p.key),
                class: "rank-tab #{'is-active' if p.key == @period.key}",
                data: { turbo: false } %>
        <% end %>
      </div>
    <% end %>

    <%# CTA para convidados %>
    <% unless user_signed_in? %>
      <div class="rank-cta">
        <p class="rank-cta-text">
          Entre no ranking!<br>
          <small>Faça login para salvar seus resultados.</small>
        </p>
        <%= button_to "Login com Google",
              user_google_oauth2_omniauth_authorize_path,
              method: :post,
              data: { turbo: false },
              class: "rank-cta-btn" %>
      </div>
    <% end %>

    <% if @entries.any? %>
      <%= render "ranking/ranking_list", entries: @entries %>
    <% else %>
      <p class="rank-empty">Nenhum resultado <%= @period.key == :all_time ? "ainda" : "neste período" %>.<br>Seja o primeiro! 🏆</p>
    <% end %>

    <%= link_to "← Jogar agora", root_path, class: "rank-back" %>
  </div>
</div>
