<% content_for :title, "Ranking — Torcedor Maluco" %>

<div class="tm-app">
  <%# Band verde: voltar + título centralizado %>
  <div class="rank-band">
    <div class="rank-topbar">
      <%= link_to "‹", root_path, class: "band-iconbtn", data: { turbo: false }, "aria-label": "Voltar" %>
      <b class="rank-band-title">🏆 RANKING</b>
      <span class="band-iconbtn" aria-hidden="true" style="visibility:hidden">‹</span>
    </div>
    <div class="rankHead">
      <h2 class="rankHead-h2">A torcida de hoje</h2>
      <p class="rankHead-sub">Top jogadores · Copa 2026</p>

      <%# Pódio: top-3 em ordem visual 2-1-3 %>
      <% top = @entries.first(3) %>
      <% if top.any? %>
        <div class="podium">
          <% [top[1], top[0], top[2]].compact.each do |entry| %>
            <div class="pod p<%= entry.rank %>">
              <span class="avatar avatar--podium" style="background:<%= avatar_color(entry.nickname) %>;">
                <%= avatar_monogram(entry.nickname) %>
              </span>
              <p class="pod-name"><%= truncate(entry.nickname, length: 10) %></p>
              <p class="pod-pts"><%= entry.value %></p>
              <div class="pod-bar"><%= entry.rank %>º</div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Lista: cartão creme que sobe sobre o verde %>
  <div class="rank-body">
    <%# Toggle de período — só aparece quando há mais de um período habilitado. %>
    <% if @periods.size > 1 %>
      <div class="rank-tabs">
        <% @periods.each do |p| %>
          <%= link_to p.label, ranking_path(period: p.key),
                class: "rank-tab #{'is-active' if p.key == @period.key}",
                data: { turbo: false } %>
        <% end %>
      </div>
    <% end %>

    <% if @entries.any? %>
      <%= render "ranking/ranking_list", entries: @entries, period_key: @period.key %>
    <% else %>
      <p class="rank-empty">Nenhum resultado <%= @period.key == :all_time ? "ainda" : "neste período" %>.<br>Seja o primeiro! 🏆</p>
    <% end %>
  </div>

  <%# CTA Premium — usuário logado sem assinatura %>
  <% if user_signed_in? && !current_user.premium? %>
    <div class="loginbar">
      <p class="loginbar-text"><b>Concorra a prêmios.</b><br>Assinantes em 1º lugar ganham prêmios todo mês.</p>
      <%= button_to "Assinar Premium · R$5/mês", create_payments_path,
            method: :post, data: { turbo: false },
            form: { class: "loginbar-form" },
            class: "loginbar-btn" %>
    </div>
  <% end %>

  <%# Faixa de login — apenas para convidados %>
  <% unless user_signed_in? %>
    <div class="loginbar">
      <p class="loginbar-text"><b>Entre pra valer ponto.</b><br>Salve seu recorde e suba no ranking.</p>
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            form: { class: "loginbar-form" },
            class: "loginbar-btn" do %>
        <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.2 13.2 17.6 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.1 5.3-4.6 7l7.1 5.5c4.2-3.9 6.7-9.6 6.7-17z"/>
          <path fill="#FBBC05" d="M10.4 28.3c-.5-1.4-.8-2.9-.8-4.3s.3-2.9.8-4.3l-7.8-6.1C.9 16.7 0 20.2 0 24s.9 7.3 2.6 10.4l7.8-6.1z"/>
          <path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7.1-5.5c-2 1.3-4.6 2.1-8.1 2.1-6.4 0-11.8-3.7-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/>
        </svg>
        Entrar
      <% end %>
    </div>
  <% end %>
</div>
