<% content_for :title, "Escolha seu nickname — Torcedor Maluco" %>

<div class="tm-app">
  <%= render "matches/header" %>

  <div class="form-wrap">
    <h1 class="form-title">Escolha seu nickname</h1>
    <p class="form-hint">Como você vai aparecer no ranking. Pode mudar depois.</p>

    <%= form_with url: nickname_path, method: :post do |f| %>
      <div class="form-fields">
        <%= f.text_field :nickname,
            value: @suggested,
            placeholder: "Ex: Torcedor_10",
            maxlength: 18,
            autocomplete: "off",
            class: "nick" %>

        <p class="form-help">3–18 caracteres. Apenas letras, números, _ ou -</p>

        <% if current_user.errors[:nickname].any? %>
          <p class="form-error"><%= current_user.errors[:nickname].first %></p>
        <% end %>

        <%= f.submit "Entrar no ranking →", class: "btn btn-share" %>
      </div>
    <% end %>
  </div>
</div>
