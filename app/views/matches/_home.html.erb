<%# Tela 1 — Home / Entrada. Renderizada dentro de #match. %>
<div class="home field">
  <div class="home-hero">
    <span class="logo-sticker">⚡ O QUIZ DA TORCIDA</span>
    <h1 class="logo"><span class="l1">Torcedor</span><span class="l2">Maluco</span></h1>
    <p class="home-sub">Prove que você <b>manja de futebol</b>.<br>5 perguntas, 1 minuto.</p>
    <% if user_signed_in? %>
      <div class="energy-home"><%= render "matches/energy", detailed: true %></div>
    <% end %>
  </div>

  <div class="home-card">
    <% display_name = user_signed_in? ? current_user.nickname : session[:nickname].presence %>
    <% if display_name %>
      <p class="greeting">E aí, <b><%= display_name %></b>! Bora marcar um golaço? 👋</p>
    <% end %>

    <% if user_signed_in? %>
      <%= form_with url: start_match_path, method: :post, data: { turbo_frame: "match" } do |f| %>
        <%= f.submit "Jogar agora ⚽", class: "btn btn-play" %>
      <% end %>
    <% else %>
      <% guest_nick = session[:nickname].presence %>
      <% editing    = params[:edit_nick].present? || guest_nick.nil? %>
      <%= form_with url: start_match_path, method: :post, data: { turbo_frame: "match" } do |f| %>
        <% if editing %>
          <%= f.label :nickname, "Seu apelido (opcional)", class: "field-lbl" %>
          <%= f.text_field :nickname, value: guest_nick,
                maxlength: 18, autocomplete: "off",
                placeholder: "Ex.: Craque do Bairro", class: "nick" %>
        <% end %>
        <%= f.submit "Jogar agora ⚽", class: "btn btn-play" %>
      <% end %>
    <% end %>

    <div class="home-meta">
      <% if user_signed_in? %>
        <%= link_to "Trocar apelido", new_nickname_path, class: "home-meta-link", data: { turbo: false } %>
      <% elsif session[:nickname].present? && params[:edit_nick].blank? %>
        <%= link_to "Trocar apelido", root_path(edit_nick: 1), class: "home-meta-link", data: { turbo: false } %>
      <% else %>
        <span></span>
      <% end %>
      <span class="home-free"><span class="dot-green"></span> Grátis e sem anúncios</span>
    </div>

    <% if @players_today.to_i > 0 %>
      <div class="social">
        <div class="social-avs">
          <span class="avatar avatar--sm" style="background:<%= avatar_color("A0") %>;">A</span>
          <span class="avatar avatar--sm" style="background:<%= avatar_color("B1") %>;">B</span>
          <span class="avatar avatar--sm" style="background:<%= avatar_color("C2") %>;">C</span>
        </div>
        <span>+<%= number_with_delimiter(@players_today) %> torcedores já jogaram hoje</span>
      </div>
    <% end %>

    <%= link_to "🏆 Ver ranking", ranking_path, class: "ranking-link", data: { turbo: false } %>

    <% unless user_signed_in? %>
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            form: { class: "gbtn-wrap" },
            class: "gbtn" do %>
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.2 13.2 17.6 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.1 5.3-4.6 7l7.1 5.5c4.2-3.9 6.7-9.6 6.7-17z"/>
          <path fill="#FBBC05" d="M10.4 28.3c-.5-1.4-.8-2.9-.8-4.3s.3-2.9.8-4.3l-7.8-6.1C.9 16.7 0 20.2 0 24s.9 7.3 2.6 10.4l7.8-6.1z"/>
          <path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7.1-5.5c-2 1.3-4.6 2.1-8.1 2.1-6.4 0-11.8-3.7-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/>
        </svg>
        Entrar com Google para o ranking
      <% end %>
    <% end %>
  </div>
</div>
