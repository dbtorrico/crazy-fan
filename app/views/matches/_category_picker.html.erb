<%# Seletor de categoria — radio inputs estilizados como pills.
    Funciona sem JS: o radio selecionado envia tema= no form. %>
<% counts = category_counts || {} %>
<span class="cat-label">Escolha o tema</span>
<div class="cat-grid">
  <% Quiz::Question::CATEGORIES.each_with_index do |cat, i| %>
    <%
      available = cat[:key].nil? || counts[cat[:key]].to_i >= 5
      pill_id   = "cat_#{i}"
    %>
    <label class="cat-pill<%= ' is-disabled' unless available %>" for="<%= pill_id %>">
      <%= f.radio_button :tema, cat[:key].to_s, id: pill_id,
            checked: i == 0, disabled: !available %>
      <span class="cat-pill-emoji"><%= cat[:emoji] %></span>
      <span class="cat-pill-label"><%= cat[:label] %></span>
      <% unless available %>
        <span class="cat-pill-soon">em breve</span>
      <% end %>
    </label>
  <% end %>
</div>
