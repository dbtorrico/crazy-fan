<%# Google Analytics 4 — só ativa quando GA_MEASUREMENT_ID está configurada (produção).
    send_page_view: false + listener de turbo:load: o Turbo Drive troca páginas sem
    recarregar, então o page_view é disparado manualmente a cada navegação
    (turbo:load também dispara no primeiro load, cobrindo os dois casos sem duplicar). %>
<% if (ga_id = ENV["GA_MEASUREMENT_ID"]).present? %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= ga_id %>', { send_page_view: false });
    document.addEventListener('turbo:load', function() {
      gtag('event', 'page_view', {
        page_location: window.location.href,
        page_title: document.title
      });
    });
  </script>
<% end %>
