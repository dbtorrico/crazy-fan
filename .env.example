# Google OAuth2 — obter em https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Mercado Pago — obter em https://www.mercadopago.com.br/developers/panel/
# Usar Access Token de teste (prefixo TEST-) em dev; produção em produção.
MP_ACCESS_TOKEN=your-mp-access-token-here
